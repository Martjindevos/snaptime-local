{
  "appId": "com.snaptime.local",
  "productName": "SnapTime Local",
  "files": [
    "dist/**/*",
    "node_modules/**/*"
  ],
  "directories": {
    "buildResources": "assets",
    "output": "release"
  },
  "mac": {
    "target": ["dmg", "zip"],
    "category": "public.app-category.photography",
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  },
  "dmg": {
    "window": {
      "width": 500,
      "height": 300
    },
    "contents": [
      {
        "x": 80,
        "y": 130,
        "type": "file"
      },
      {
        "x": 350,
        "y": 130,
        "type": "link",
        "path": "/Applications"
      }
    ]
  }
}
